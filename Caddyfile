# ── Production ─────────────────────────────────────────────────────────────────
# Three domains, two responsibilities:
#
#   thesis.lucamolluso.com   — serves the Vite production build (static files from dist/)
#   api.lucamolluso.com      — reverse-proxies to Express (API endpoints, VITE_API_URL)
#   socket.lucamolluso.com   — reverse-proxies to Express (Socket.IO, VITE_SOCKET_URL)
#
# CORS on Express must list thesis.lucamolluso.com as an allowed origin.
# Caddy handles TLS automatically via Let's Encrypt — no extra config needed.

thesis.lucamolluso.com {
    root * /home/admin/HARMONY/dist

    encode gzip

    # MPA fallbacks: /remote/* → remote/index.html, everything else → index.html.
    # This mirrors the Express catch-all routes used in development.
    handle /remote/* {
        try_files {path} /remote/index.html
    }
    handle {
        try_files {path} /index.html
    }

    file_server
}

remote.lucamolluso.com {
    root * /home/admin/HARMONY/dist

    encode gzip

    # Serve the remote UI; token validation is handled by the app, not Caddy.
    try_files {path} /remote/index.html
    file_server
}

api.lucamolluso.com {
    # Express API endpoints (static assets, images, narration).
    # Caddy proxies WebSocket upgrade handshakes automatically.
    reverse_proxy localhost:3000
}

socket.lucamolluso.com {
    # Socket.IO long-polling and WebSocket upgrade.
    reverse_proxy localhost:3000
}


# ── Local development ──────────────────────────────────────────────────────────
# Used with `caddy trust` (installs local CA) for HTTPS in dev.
# Vite dev server runs on :5173; Express on :3000.
# Socket.IO clients connect directly to Express (no Caddy proxy needed for sockets in dev).

localhost, 192.168.1.12 {
    tls internal

    # Proxy Socket.IO directly to Express.
    reverse_proxy /socket.io* localhost:3000

    # All other requests go to the Vite dev server.
    reverse_proxy localhost:5173
}

api.localhost {
    tls internal

    # Everything goes to Express (API + Socket.IO).
    reverse_proxy localhost:3000
}

# Import additional caddy config files in /etc/caddy/conf.d/
import /etc/caddy/conf.d/*
