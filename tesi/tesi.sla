        <PAGE PAGEXPOS="519.528188976378" PAGEYPOS="23525.2913385827" PAGEWIDTH="419.527559055118" PAGEHEIGHT="595.275590551181" BORDERLEFT="56.6929133858268" BORDERRIGHT="56.6929133858268" BORDERTOP="56.6929133858268" BORDERBOTTOM="85.0393700787402" NUM="74" NAM="" MNAM="empty right" Size="A5" Orientation="0" LEFT="0" PRESET="0" VerticalGuides="" HorizontalGuides="" AGhorizontalAutoGap="14.1732283464567" AGverticalAutoGap="14.1732283464567" AGhorizontalAutoCount="5" AGverticalAutoCount="5" AGhorizontalAutoRefer="1" AGverticalAutoRefer="1" AGSelection="0 0 0 0" pageEffectDuration="1" pageViewDuration="1" effectType="0" Dm="0" M="0" Di="0"/>
